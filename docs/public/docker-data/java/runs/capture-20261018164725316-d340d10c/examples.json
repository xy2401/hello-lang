      "id": "version",
      "title": "版本",
      "notes": [
        "固定 SDKMAN 候选 21.0.11-tem；java -version 兼容 Java 8，版本信息在 stderr。"
      ],
      "steps": [
        {
          "id": "java-version",
          "argv": [
            "java",
            "-version"
          ],
          "cwd": "/capture/work",
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0,
              "passed": true
            },
            {
              "stream": "stderr",
              "op": "includes",
              "value": "21.0.11",
              "passed": true
            }
          ],
          "stdin": null,
          "stdout": "",
          "stderr": "openjdk version \"21.0.11\" 2026-04-21 LTS\nOpenJDK Runtime Environment Temurin-21.0.11+10 (build 21.0.11+10-LTS)\nOpenJDK 64-Bit Server VM Temurin-21.0.11+10 (build 21.0.11+10-LTS, mixed mode, sharing)\n",
          "exitCode": 0,
          "status": "passed"
        },
        {
          "id": "javac-version",
          "argv": [
            "javac",
            "-version"
          ],
          "cwd": "/capture/work",
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0,
              "passed": true
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "21.0.11",
              "passed": true
            }
          ],
          "stdin": null,
          "stdout": "javac 21.0.11\n",
          "stderr": "",
          "exitCode": 0,
          "status": "passed"
        }
      ],
      "status": "passed"
    },
    {
      "id": "compile-run",
      "title": "编译与运行",
      "notes": [
        "使用挂载目录 /capture/work；命令退出码和输出分别保留。"
      ],
      "steps": [
        {
          "id": "compile",
          "argv": [
            "bash",
            "-c",
            "javac /capture/work/Main.java && test -s /capture/work/Main.class"
          ],
          "cwd": "/capture/work",
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0,
              "passed": true
            }
          ],
          "stdin": null,
          "stdout": "",
          "stderr": "",
          "exitCode": 0,
          "status": "passed"
        },
        {
          "id": "run",
          "argv": [
            "java",
            "-cp",
            "/capture/work",
            "Main"
          ],
          "cwd": "/capture/work",
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0,
              "passed": true
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "hello-java-capture",
              "passed": true
            }
          ],
          "stdin": null,
          "stdout": "hello-java-capture\n",
          "stderr": "",
          "exitCode": 0,
          "status": "passed"
        }
      ],
      "status": "passed"
    },
    {
      "id": "jar",
      "title": "JAR 打包与列表",
      "notes": [
        "使用 Java 8 及后续版本均支持的 cf/tf 选项，案例自行编译。"
      ],
      "steps": [
        {
          "id": "package",
          "argv": [
            "bash",
            "-c",
            "javac /capture/work/Main.java && jar cf /capture/work/main.jar -C /capture/work Main.class && test -s /capture/work/main.jar"
          ],
          "cwd": "/capture/work",
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0,
              "passed": true
            }
          ],
          "stdin": null,
          "stdout": "",
          "stderr": "",
          "exitCode": 0,
          "status": "passed"
        },
        {
          "id": "list",
          "argv": [
            "jar",
            "tf",
            "/capture/work/main.jar"
          ],
          "cwd": "/capture/work",
          "assertions": [
            {
              "stream": "exitCode",
              "op": "equals",
              "value": 0,
              "passed": true
            },
            {
              "stream": "stdout",
              "op": "includes",
              "value": "Main.class",
              "passed": true
            }
          ],
          "stdin": null,
          "stdout": "META-INF/\nMETA-INF/MANIFEST.MF\nMain.class\n",
          "stderr": "",
          "exitCode": 0,
          "status": "passed"
        }
      ],
      "status": "passed"
    },
